# ============================================================
# lvl2do — variáveis de ambiente (exemplo)
# ============================================================
# Copie este arquivo para .env.local e preencha os valores.
# NÃO coloque chaves reais aqui — este arquivo vai para o Git.
#
# Supabase (NECESSÁRIO)
# Dashboard: Project Settings > API
#   - NEXT_PUBLIC_SUPABASE_URL      => campo "Project URL"
#   - NEXT_PUBLIC_SUPABASE_ANON_KEY => campo "anon public" (Project API keys)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ============================================================
# Pagamento / Assinatura (OPCIONAL nesta fase — ver docs/paymentsystem.md)
# Sem estas variáveis, o paywall funciona mas o checkout fica indisponível
# (a UI mostra o aviso) e o guard server-side permanece desligado.
# ============================================================

# RevenueCat — Web Billing (chave PÚBLICA do cliente)
# Dashboard RevenueCat > API keys > Web Billing (public)
NEXT_PUBLIC_REVENUECAT_WEB_API_KEY=

# Webhook do RevenueCat (server-only) — segredo do header Authorization
REVENUECAT_WEBHOOK_SECRET=

# Supabase Service Role Key (server-only) — usada SÓ pelo webhook para gravar
# subscription_* no profiles ignorando RLS. NUNCA exponha no cliente.
SUPABASE_SERVICE_ROLE_KEY=

# Liga o guard de acesso no SERVIDOR (middleware). Deixe vazio/false enquanto o
# pagamento real não estiver ativo (senão bloqueia todos). Use "true" só depois.
ENABLE_SERVER_ACCESS_GUARD=
